### Wallet
@name = Wallet
@details = View balances of assets across chains.

### Environment Variables
@HOST={{base_url}}
@USER_ID={{user_id}}
@AUTH_HEADER=Authorization: Bearer {{api_key}}

### Stablecoin balance on one chain
# @name GetOnchainCoinBalance
@CHAIN=Sepolia
@COIN=USDT
GET {{HOST}}/wallet/onchain/balance/{{USER_ID}}/{{CHAIN}}/{{COIN}}
{{AUTH_HEADER}}

### All stablecoin balances on one chain
# @name GetOnchainAllCoinBalances
@CHAIN=Sepolia
GET {{HOST}}/wallet/onchain/balances/{{USER_ID}}/{{CHAIN}}
{{AUTH_HEADER}}

### All wallet balances
# @name GetWalletBalances
GET {{HOST}}/wallet/balances/{{USER_ID}}
{{AUTH_HEADER}}

### Wallet balances grouped by chain
# @name GetWalletBalancesByChain
@CHAIN=Sepolia
GET {{HOST}}/wallet/balances/by_chain/{{USER_ID}}/{{CHAIN}}
{{AUTH_HEADER}}

### Wallet balances grouped by stablecoin
# @name GetWalletBalancesByCoin
@COIN=USDT
GET {{HOST}}/wallet/balances/by_coin/{{USER_ID}}/{{COIN}}
{{AUTH_HEADER}}
