### History
@name = History
@details = Resolve merchant sessions and inspect payment receipts.

### Environment Variables
@HOST={{base_url}}
@USER_ID={{user_id}}
@AUTH_HEADER=Authorization: Bearer {{api_key}}

### Receipt ID associated with a merchant payment session
# @name GetPaymentSessionStatus
@SESSION_ID=replace-with-payment-session-id
GET {{HOST}}/payment/merchant/session/{{SESSION_ID}}
{{AUTH_HEADER}}

### One payment receipt
# @name GetOcpReceipt
@RECEIPT_ID=1r24349050eb039cd05af1800c
GET {{HOST}}/payment/onchain/receipt/{{RECEIPT_ID}}
{{AUTH_HEADER}}

### First page of payment receipts with an optional chain filter
# @name GetOcpReceiptsFirstPage
@SORT_BY_LATEST=true
@FROM_START=true
@LIMIT=20
@CHAIN=Sepolia
GET {{HOST}}/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}
{{AUTH_HEADER}}

### Next page; use the last receipt ID returned by the current page
# @name GetOcpReceiptsNextPage
@FROM_START=false
@CURSOR_RECEIPT_ID=replace-with-last-receipt-id
GET {{HOST}}/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}&next_or_previous=true&cursor={{CURSOR_RECEIPT_ID}}
{{AUTH_HEADER}}
