### History
@name = History
@details = Resolve merchant sessions and inspect payment receipts.

### Environment Variables
@HOST={{base_url}}
@USER_ID={{user_id}}
@AUTH_HEADER=Authorization: Bearer {{api_key}}

### Merchant payment session ID
# @name GetPaymentSessionStatus
@SESSION_ID=replace-with-payment-session-id
GET {{HOST}}/v1/payment/merchant/session/{{SESSION_ID}}
{{AUTH_HEADER}}

### One payment receipt
# @name GetOcpReceipt
@RECEIPT_ID=1r24349050eb039cd05af1800c
GET {{HOST}}/v1/payment/onchain/receipt/{{RECEIPT_ID}}
{{AUTH_HEADER}}

@SORT_BY_LATEST=true
@FIRST_PAGE_FROM_START=true
@NEXT_PAGE_FROM_START=false
@LIMIT=20
@CHAIN=Sepolia
@COIN=USDT
@PENDING=true
@DIRECTION=Sent

# pending=true matches Processing and Confirmed receipts. Do not combine pending with status.

# -----------------------------------------------------------------------------
# get_ocp_receipts: server-managed Redis pagination
# -----------------------------------------------------------------------------

### First page; stores the page boundary in Redis for 15 minutes
# @name GetOcpReceiptsRedisFirstPage
GET {{HOST}}/v1/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{FIRST_PAGE_FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}&coin={{COIN}}&pending={{PENDING}}&direction={{DIRECTION}}
{{AUTH_HEADER}}

### Next page; automatically uses the Redis-cached boundary
# @name GetOcpReceiptsRedisNextPage
GET {{HOST}}/v1/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{NEXT_PAGE_FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}&coin={{COIN}}&pending={{PENDING}}&direction={{DIRECTION}}&next_or_previous=true
{{AUTH_HEADER}}

# -----------------------------------------------------------------------------
# get_ocp_receipts_with_cursor: explicit receipt-ID cursor pagination
# -----------------------------------------------------------------------------

### First page; no cursor is required
# @name GetOcpReceiptsCursorFirstPage
GET {{HOST}}/v1/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{FIRST_PAGE_FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}&coin={{COIN}}&pending={{PENDING}}&direction={{DIRECTION}}
{{AUTH_HEADER}}

### Next page; use the last receipt ID returned by the current page
# @name GetOcpReceiptsCursorNextPage
@CURSOR_RECEIPT_ID=replace-with-last-receipt-id
GET {{HOST}}/v1/payment/onchain/receipts/{{USER_ID}}/{{SORT_BY_LATEST}}/{{NEXT_PAGE_FROM_START}}?limit={{LIMIT}}&chain={{CHAIN}}&coin={{COIN}}&pending={{PENDING}}&direction={{DIRECTION}}&next_or_previous=true&cursor={{CURSOR_RECEIPT_ID}}
{{AUTH_HEADER}}
