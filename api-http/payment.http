### Pay
@name = Pay
@details = Submit custodial & self-custodial stablecoin payments.

### Environment Variables
@HOST={{base_url}}
@USER_ID={{user_id}}
@AUTH_HEADER=Authorization: Bearer {{api_key}}
@CONTENT_TYPE=Content-Type: application/json
@CHAIN=Sepolia
@COIN=USDT
@TO_ADDRESS=0x2222222222222222222222222222222222222222
@SECOND_TO_ADDRESS=0x3333333333333333333333333333333333333333
@SESSION_ID=replace-with-payment-session-id
@IS_FEE_INCL=false
@DEADLINE=1893456000
@NONCE=0
@PERMIT_SIGNATURE=replace-with-permit-signature

### Managed-wallet payment
# @name PayOnchain
POST {{HOST}}/payment/onchain/{{USER_ID}}/{{IS_FEE_INCL}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "payload": {
        "chain": "{{CHAIN}}",
        "coin": "{{COIN}}",
        "to_address": "{{TO_ADDRESS}}",
        "amount": "10.124",
        "memo": "General"
    },
    "sched": null
}

### Managed-wallet merchant payment
# @name PayOnchainMerchant
POST {{HOST}}/payment/onchain/merchant/{{USER_ID}}/{{IS_FEE_INCL}}/{{SESSION_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "chain": "{{CHAIN}}",
    "coin": "{{COIN}}",
    "to_address": "{{TO_ADDRESS}}",
    "amount": "10.124",
    "memo": "FliqPayMerchant"
}

### Create a Permit2 message for one self-custodial payment
# @name CreateDomainPermitForSignature
POST {{HOST}}/payment/onchain/ncw/create_domain_permit/{{USER_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "chain": "{{CHAIN}}",
    "coin": "{{COIN}}",
    "to_address": "{{TO_ADDRESS}}",
    "amount": "10.124",
    "est_fee": "0.12",
    "deadline": {{DEADLINE}}
}

### Create a Permit2 message for a self-custodial bulk payment
# @name CreateDomainPermitForSignatureBulkPay
POST {{HOST}}/payment/onchain/ncw/create_domain_permit_bulkpay/{{USER_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "chain": "{{CHAIN}}",
    "batch": [
        {
            "coin": "{{COIN}}",
            "to_address": "{{TO_ADDRESS}}",
            "amount": "10.124",
            "memo": "BulkPay"
        },
        {
            "coin": "USDC",
            "to_address": "{{SECOND_TO_ADDRESS}}",
            "amount": "2.50",
            "memo": "BulkPay"
        }
    ],
    "tot_est_fee": "0.12",
    "deadline": {{DEADLINE}}
}

### Submit one signed self-custodial payment
# @name PayOnchainNcw
POST {{HOST}}/payment/onchain/ncw/{{USER_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "payload": {
        "base": {
            "chain": "{{CHAIN}}",
            "coin": "{{COIN}}",
            "to_address": "{{TO_ADDRESS}}",
            "amount": "10.124",
            "est_fee": "0.12",
            "deadline": {{DEADLINE}}
        },
        "nonce": "{{NONCE}}",
        "sig": "{{PERMIT_SIGNATURE}}",
        "memo": "General"
    },
    "sched": null
}

### Submit signed self-custodial bulk payments
# @name BulkPayNcw
POST {{HOST}}/payment/onchain/ncw_bulkpay/{{USER_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "payload": {
        "base": {
            "chain": "{{CHAIN}}",
            "batch": [
                {
                    "coin": "{{COIN}}",
                    "to_address": "{{TO_ADDRESS}}",
                    "amount": "10.124",
                    "memo": "BulkPay"
                },
                {
                    "coin": "USDC",
                    "to_address": "{{SECOND_TO_ADDRESS}}",
                    "amount": "2.50",
                    "memo": "BulkPay"
                }
            ],
            "tot_est_fee": "0.12",
            "deadline": {{DEADLINE}}
        },
        "nonce": "{{NONCE}}",
        "sig": "{{PERMIT_SIGNATURE}}"
    },
    "scheds": null
}

### Submit a signed self-custodial merchant payment
# @name PayOnchainMerchantNcw
POST {{HOST}}/payment/onchain/ncw/merchant/{{USER_ID}}/{{SESSION_ID}}
{{AUTH_HEADER}}
{{CONTENT_TYPE}}

{
    "base": {
        "chain": "{{CHAIN}}",
        "coin": "{{COIN}}",
        "to_address": "{{TO_ADDRESS}}",
        "amount": "10.124",
        "est_fee": "0.12",
        "deadline": {{DEADLINE}}
    },
    "nonce": "{{NONCE}}",
    "sig": "{{PERMIT_SIGNATURE}}",
    "memo": "FliqPayMerchant"
}
